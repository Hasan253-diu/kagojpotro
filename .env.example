# ===================================================
# কাগজপত্র (Kagojpotro) - Environment Configuration
# ===================================================

# SQLite Database local path
DATABASE_URL="file:./data/kagojpotro.db"

# Local Storage Directory (outside public folder for strict AES-256-GCM encrypted files)
STORAGE_DIR="./storage/encrypted_vault"
BACKUP_DIR="./storage/backups"
TEMP_DIR="./storage/temp"

# AES-256-GCM Master Encryption Key (32 bytes / 64 hex characters)
# Must be kept secret. Do not commit or share this key!
ENCRYPTION_MASTER_KEY="4a7e9b2c1d8f3e5a6b0c2d4e6f8a1c3e5b7d9f0a2c4e6b8d0f1a3c5e7b9d1f3a"

# Session JWT / Cookie secret
SESSION_SECRET="kagojpotro_secure_session_secret_key_89234789127391287391823719"

# Node Environment
NODE_ENV="development"
PORT=3000
HOST="0.0.0.0"
